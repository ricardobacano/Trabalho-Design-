@startuml
title Diagrama de Sequência - abrir chamado
autonumber

actor Solicitante
boundary "Rota /chamados/novo" as Rota
control AbrirChamadoService as Service
database UsuarioRepositorySQLAlchemy as UserRepo
database CategoriaRepositorySQLAlchemy as CatRepo
entity Chamado
participant MatrizPrioridade as Matriz
participant PoliticaPrazo as Prazo
entity EventoHistorico
database ChamadoRepositorySQLAlchemy as ChamadoRepo
participant Notificador as Notificador

Solicitante -> Rota: POST dados do chamado
Rota -> Service: executar(comando)
Service -> UserRepo: buscar_por_id(solicitante_id)
UserRepo --> Service: solicitante
Service -> CatRepo: buscar_por_id(categoria_id)
CatRepo --> Service: categoria

alt categoria inexistente
  Service --> Rota: RegraNegocioError
  Rota --> Solicitante: HTTP 400 com mensagem
else categoria válida
  Service -> Chamado: abrir(dados, equipe_id)
  activate Chamado
  Chamado -> Chamado: validar campos
  Chamado -> Matriz: calcular(impacto, urgencia)
  Matriz --> Chamado: prioridade
  Chamado -> Prazo: calcular_prazo(prioridade, criado_em)
  Prazo --> Chamado: prazo_atendimento
  alt categoria possui equipe
    Chamado -> Chamado: estado = EM_FILA
  else categoria sem equipe
    Chamado -> Chamado: estado = EM_TRIAGEM
  end
  Chamado --> Service: chamado válido
  deactivate Chamado

  Service -> EventoHistorico: abertura(chamado, categoria, equipe)
  EventoHistorico --> Service: evento inicial
  Service -> ChamadoRepo: salvar_novo(chamado, evento)
  activate ChamadoRepo
  ChamadoRepo -> ChamadoRepo: INSERT chamado e histórico
  ChamadoRepo -> ChamadoRepo: COMMIT único
  ChamadoRepo --> Service: chamado_id
  deactivate ChamadoRepo

  Service -> Notificador: confirmar_abertura(...)
  alt confirmação enviada
    Notificador --> Service: sucesso
  else falha da notificação
    Notificador --> Service: exceção
    Service -> Service: definir aviso para o usuário (chamado já gravado)
  end
  Service --> Rota: ResultadoAbertura
  Rota --> Solicitante: redirecionar para detalhe
end
@enduml
