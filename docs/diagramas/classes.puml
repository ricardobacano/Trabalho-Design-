@startuml
title Diagrama de Classes - abertura e consulta de chamados
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members

package "Catálogo" {
  class UsuarioModel <<ORM>> {
    +id: int
    +nome: string
    +email: string
  }

  class EquipeModel <<ORM>> {
    +id: int
    +nome: string
  }

  class CategoriaModel <<ORM>> {
    +id: int
    +nome: string
    +equipe_id: int?
  }

  class CategoriaRepositorySQLAlchemy <<repository>> {
    +buscar_por_id(id): CategoriaEncontrada?
    +listar(): List<CategoriaEncontrada>
  }

  class UsuarioRepositorySQLAlchemy <<repository>> {
    +buscar_por_id(id): UsuarioEncontrado?
  }
}

package "Chamados - domínio" {
  class Chamado <<domain>> {
    +solicitante_id: int
    +categoria_id: int
    +equipe_id: int?
    +prioridade: Prioridade
    +estado: EstadoChamado
    +prazo_atendimento: datetime
    {static} +abrir(...): Chamado
  }

  class EventoHistorico <<domain>> {
    +tipo: string
    +descricao: string
    +criado_em: datetime
    {static} +abertura(chamado, categoria, equipe): EventoHistorico
  }

  class MatrizPrioridade <<policy>> {
    {static} +calcular(impacto, urgencia): Prioridade
  }

  class PoliticaPrazo <<policy>> {
    {static} +calcular_prazo(prioridade, criado_em): datetime
  }
}

package "Chamados - aplicação e persistência" {
  class AbrirChamadoService <<controller>> {
    +executar(comando): ResultadoAbertura
  }

  class ConsultarChamadosService <<controller>> {
    +listar_do_solicitante(id): List<ChamadoResumo>
    +detalhar_do_solicitante(chamado_id, solicitante_id): ChamadoDetalhe?
  }

  class ChamadoRepositorySQLAlchemy <<repository>> {
    +salvar_novo(chamado, evento): int
    +listar_por_solicitante(id): List<ChamadoResumo>
    +buscar_por_id_e_solicitante(chamado_id, solicitante_id): ChamadoDetalhe?
  }

  class ChamadoModel <<ORM>> {
    +id: int
    +solicitante_id: int
    +categoria_id: int
    +equipe_id: int?
    +prioridade: string
    +estado: string
  }

  class EventoHistoricoModel <<ORM>> {
    +id: int
    +chamado_id: int
    +tipo: string
    +descricao: string
  }
}

package "Notificações" {
  interface Notificador {
    +confirmar_abertura(confirmacao): void
  }

  class NotificadorFake {
    +confirmar_abertura(confirmacao): void
  }
}

UsuarioModel "1" -- "0..*" ChamadoModel
CategoriaModel "1" -- "0..*" ChamadoModel
EquipeModel "0..1" -- "0..*" CategoriaModel
EquipeModel "0..1" -- "0..*" ChamadoModel
ChamadoModel "1" *-- "1..*" EventoHistoricoModel

AbrirChamadoService --> CategoriaRepositorySQLAlchemy : consulta
AbrirChamadoService --> UsuarioRepositorySQLAlchemy : consulta
AbrirChamadoService --> Chamado : cria
AbrirChamadoService --> EventoHistorico : cria
AbrirChamadoService --> ChamadoRepositorySQLAlchemy : persiste
ConsultarChamadosService --> ChamadoRepositorySQLAlchemy : consulta
AbrirChamadoService --> Notificador : confirma
NotificadorFake ..|> Notificador
Chamado --> MatrizPrioridade : calcula prioridade
Chamado --> PoliticaPrazo : calcula prazo
ChamadoRepositorySQLAlchemy ..> ChamadoModel
ChamadoRepositorySQLAlchemy ..> EventoHistoricoModel
CategoriaRepositorySQLAlchemy ..> CategoriaModel
UsuarioRepositorySQLAlchemy ..> UsuarioModel
@enduml
