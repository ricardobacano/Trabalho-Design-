@startuml
title Diagrama de Componentes - monólito modular
skinparam componentStyle rectangle
skinparam packageStyle rectangle
left to right direction

actor Solicitante

node "Processo Flask\n(monólito modular)" {
  component "Apresentação Web\nrotas + Jinja2" as Web

  package "Módulo Chamados" {
    component "Aplicação\nAbrir e Consultar Chamados" as App
    component "Domínio\nChamado, prioridade e prazo" as Domain
    component "Persistência de chamados\nSQLAlchemy" as TicketPersistence
  }

  package "Módulo Catálogo" {
    component "Persistência de catálogo\nusuários, categorias e equipes" as Catalog
  }

  package "Módulo Notificações" {
    interface Notificador
    component "NotificadorFake\n<<simulação externa>>" as Fake
  }
}

database "SQLite" as DB

Solicitante --> Web : HTTP
Web --> App : chamada local
App --> Domain : cria e aplica regras
App --> Catalog : busca categoria e usuário
App --> TicketPersistence : transação local
App --> Notificador : confirmação
Fake ..|> Notificador
TicketPersistence --> DB : SQLAlchemy
Catalog --> DB : SQLAlchemy
@enduml
